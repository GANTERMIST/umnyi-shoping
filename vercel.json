{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build && rm -rf ../public && cp -r dist ../public",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{app/**,deploy/**}",
      "excludeFiles": "{frontend/**,tests/**,docs/**,data/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|api/|docs|openapi)[^.]*)",
      "destination": "/index.html"
    }
  ]
}
