# Помощник: model — своя модель ShopNLU (по умолчанию), rules — правила, claude — внешний API (нужен ключ ниже)
ASSISTANT_ENGINE=model
# Ключ Anthropic API — нужен только при ASSISTANT_ENGINE=claude. Своей модели ключ не нужен.
ANTHROPIC_API_KEY=

# Модель ассистента (по умолчанию claude-opus-5-5)
# ASSISTANT_MODEL=claude-opus-5-5

# Разрешённые источники для фронта, через запятую (по умолчанию все)
# CORS_ORIGINS=http://localhost:5173

# Где хранить историю цен
# DATA_DIR=data

# Вход через Telegram: бот от @BotFather, у бота /setdomain = домен сайта
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
